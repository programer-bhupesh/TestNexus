<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Results for Assigned Tests - Test Nexus</title>
    <style>
      table {
        border-collapse: collapse;
        width: 80%;
        margin: 20px auto;
      }

      th,
      td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }

      th {
        background-color: #f2f2f2;
      }

      .no-results {
        text-align: center;
        margin: 20px;
      }
    </style>
  </head>

  <body>
    <h1>Test Results for Assigned Tests</h1>
    <a href="/teacher">Back to Dashboard</a>
    <% if (responses.length===0) { %>
    <p class="no-results">No results available yet.</p>
    <% } else { %>
    <table>
      <tr>
        <th>Student</th>
        <th>Test Name</th>
        <th>Question</th>
        <th>Score</th>
        <th>Total Score</th>
      </tr>
      <% responses.forEach(function(response) { %> <% if (response.studentId &&
      response.testId) { %> <% response.answers.forEach(function(answer, index)
      { %>
      <tr>
        <% if (index===0) { %>
        <td rowspan="<%= response.answers.length %>">
          <%= response.studentId.username %>
        </td>
        <td rowspan="<%= response.answers.length %>">
          <%= response.testId.testName %>
        </td>
        <% } %>
        <td>
          <%= answer.questionId ? 'Question ' + (index + 1) : 'Unknown Question'
          %>
        </td>
        <td><%= answer.score !==undefined ? answer.score : 'N/A' %></td>
        <% if (index===0) { %>
        <td rowspan="<%= response.answers.length %>">
          <%= response.totalScore !==undefined ? response.totalScore : 'N/A' %>
        </td>
        <% } %>
      </tr>
      <% }); %> <% } else { %>
      <tr>
        <td>
          <%= response.studentId ? response.studentId.username : 'UnknownStudent' %>
        </td>
        <td>
          <%= response.testId ? response.testId.testName : 'Test Not Found' %>
        </td>
        <td colspan="2">N/A</td>
        <td>
          <%= response.totalScore !==undefined ? response.totalScore : 'N/A' %>
        </td>
      </tr>
      <% } %> <% }); %>
    </table>
    <% } %>
  </body>
</html>
