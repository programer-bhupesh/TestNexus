<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Student - Test Nexus</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #e0e0e0;
            padding: 40px;
        }

        .form-container {
            max-width: 550px;
            width: 100%;
            background: rgba(34, 34, 66, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease-in-out;
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #3498db, #2980b9);
            opacity: 0.2;
            z-index: 0;
            pointer-events: none;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 25px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 1;
        }

        label {
            display: block;
            margin: 20px 0 8px;
            color: #d0d0e0;
            font-weight: 500;
            font-size: 1.1em;
            position: relative;
            z-index: 1;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 12px 15px;
            border: none;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-size: 1em;
            box-sizing: border-box;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
            position: relative;
            z-index: 1;
        }

        input[type="email"]:focus,
        input[type="text"]:focus,
        input[type="password"]:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.6);
        }

        input[type="submit"] {
            background: linear-gradient(to right, #3498db, #2980b9);
            color: #ffffff;
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1.2em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin: 30px auto 0;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        input[type="submit"]:hover {
            background: linear-gradient(to right, #2980b9, #3498db);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.6);
        }

        a {
            display: block;
            text-align: center;
            color: #3498db;
            font-size: 1.2em;
            margin-top: 20px;
            text-decoration: none;
            transition: color 0.3s ease, transform 0.3s ease;
            position: relative;
            z-index: 1;
        }

        a:hover {
            color: #2980b9;
            transform: translateY(-2px);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            .form-container {
                padding: 20px;
                max-width: 90%;
            }

            h1 {
                font-size: 1.8em;
            }

            input[type="email"],
            input[type="text"],
            input[type="password"] {
                padding: 10px;
                font-size: 1em;
            }

            input[type="submit"] {
                padding: 10px 20px;
                font-size: 1em;
            }

            a {
                font-size: 1em;
            }
        }
    </style>
</head>

<body>
    <div class="form-container">
        <h1>Update Student: <%= student.username %>
        </h1>
        <form action="/students/<%= student._id %>/update" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= student.email || '' %>"
                placeholder="Leave blank to keep current">

            <label for="fullName">Full Name:</label>
            <input type="text" id="fullName" name="fullName" value="<%= student.fullName || '' %>"
                placeholder="Leave blank to keep current">

            <label for="password">New Password (optional):</label>
            <input type="password" id="password" name="password" placeholder="Leave blank to keep current">

            <input type="submit" value="Update Student">
        </form>
        <a href="/total-students">Back to Students</a>
    </div>
</body>

</html>