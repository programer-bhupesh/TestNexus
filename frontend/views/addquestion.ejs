<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Question to <%= test.testName %>
    </title>
</head>

<body>
    <h1>Add Question to <%= test.testName %>
    </h1>
    <form action="/tests/<%= test._id %>/questions" method="POST">
        <label for="type">Question Type:</label>
        <select id="type" name="type" required onchange="toggleFields()">
            <option value="multiple-choice">Multiple Choice</option>
            <option value="coding">Coding</option>
        </select><br>

        <label for="questionText">Question Text:</label>
        <textarea id="questionText" name="questionText" required></textarea><br>

        <div id="mc-fields">
            <label for="options">Options (comma-separated, e.g., Option1, Option2, Option3, Option4):</label>
            <input type="text" id="options" name="options" placeholder="Option1, Option2, Option3, Option4"><br>
            <label for="correctAnswer">Correct Answer Index (e.g., 0 for Option1):</label>
            <input type="number" id="correctAnswer" name="correctAnswer" min="0" max="3"><br>
        </div>

        <div id="coding-fields" style="display: none;">
            <label for="language">Programming Language (e.g., javascript, python):</label>
            <input type="text" id="language" name="language"><br>
            <label for="testCases">Test Cases (JSON format, e.g., [{"input": "1", "expectedOutput": "2"}]):</label>
            <textarea id="testCases" name="testCases"></textarea><br>
        </div>

        <button type="submit">Add Question</button>
    </form>

    <script>
        function toggleFields() {
            const type = document.getElementById("type").value;
            document.getElementById("mc-fields").style.display = type === "multiple-choice" ? "block" : "none";
            document.getElementById("coding-fields").style.display = type === "coding" ? "block" : "none";
        }
        toggleFields(); // Initial toggle based on default selection
    </script>
</body>

</html>
