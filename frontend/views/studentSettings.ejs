<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Nexus - Student Dashboard</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            /* Deep midnight blue gradient */
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
            color: #e0e0e0;
            overflow-x: hidden;
        }

        /* Toggle Button Styles */
        .toggle-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            background: linear-gradient(45deg, #3498db, #2980b9);
            /* Blue to deep blue */
            border: none;
            border-radius: 12px;
            width: 50px;
            height: 50px;
            font-size: 24px;
            color: #ffffff;
            cursor: pointer;
            z-index: 1100;
            transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

        .toggle-btn:hover {
            background: linear-gradient(45deg, #2980b9, #3498db);
            /* Reverse gradient */
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.6);
        }

        .toggle-btn.active {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
            /* Purple to deep purple */
        }

        .toggle-btn.active:hover {
            background: linear-gradient(45deg, #8e44ad, #9b59b6);
            box-shadow: 0 0 15px rgba(155, 89, 182, 0.6);
        }

        .toggle-btn span {
            display: inline-block;
            transition: transform 0.3s ease, opacity 0.3s ease;
            /* Smooth icon transition */
        }

        .toggle-btn.active span {
            transform: rotate(180deg);
            opacity: 0.9;
        }

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 270px;
            height: 100vh;
            background: #252545;
            /* Dark slate with a hint of purple */
            transform: translateX(-100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            padding: 90px 0 20px;
            overflow-y: auto;
            /* Scrollable */
            scrollbar-width: thin;
            scrollbar-color: #3498db #252545;
            /* Custom blue scrollbar */
        }

        .sidebar::-webkit-scrollbar {
            width: 8px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #3498db;
            /* Blue scrollbar */
            border-radius: 4px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: #252545;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(52, 152, 219, 0.2), rgba(52, 152, 219, 0));
            /* Subtle blue fade */
            pointer-events: none;
        }

        .sidebar .nav-list {
            list-style: none;
            padding: 0 15px;
        }

        .sidebar .nav-item {
            margin-bottom: 10px;
            position: relative;
        }

        .sidebar .nav-item a {
            display: flex;
            align-items: center;
            padding: 15px 25px;
            color: #d8d8e8;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 400;
            transition: all 0.3s ease;
            border-radius: 10px;
            position: relative;
            z-index: 1;
        }

        .sidebar .nav-item a::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 10px;
            width: 6px;
            height: 6px;
            background: #3498db;
            /* Blue dot */
            border-radius: 50%;
            opacity: 0;
            transform: translateY(-50%);
            transition: opacity 0.3s ease, left 0.3s ease;
        }

        .sidebar .nav-item a:hover::after {
            opacity: 1;
            left: 15px;
        }

        .sidebar .nav-item a:hover {
            color: #ffffff;
            background: rgba(52, 152, 219, 0.1);
            /* Subtle blue overlay */
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        .sidebar .nav-item a[href="/logout"] {
            color: #e74c3c;
            /* Red for logout */
        }

        .sidebar .nav-item a[href="/logout"]::after {
            background: #e74c3c;
            /* Red dot */
        }

        .sidebar .nav-item a[href="/logout"]:hover {
            color: #ff7066;
            background: rgba(231, 76, 60, 0.1);
        }

        /* Main Content Area */
        .main-content {
            padding: 100px 20px 20px 80px;
            transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar.active~.main-content {
            padding-left: 350px;
        }

        .main-content h1 {
            font-size: 3.5em;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5), 0 0 12px rgba(52, 152, 219, 0.2);
            /* Subtle blue glow */
            margin-bottom: 20px;
        }

        .main-content h2 {
            font-size: 1.9em;
            color: #b0b0c0;
            font-weight: 300;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
            letter-spacing: 1px;
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .sidebar {
                width: 220px;
            }

            .sidebar.active~.main-content {
                padding-left: 280px;
            }

            .main-content h1 {
                font-size: 2.6em;
            }

            .main-content h2 {
                font-size: 1.6em;
            }

            .toggle-btn {
                width: 42px;
                height: 42px;
                font-size: 20px;
            }
        }


        .settings-container {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .settings-container h2 {
            color: #2c3e50;
            text-align: center;
        }

        .message {
            text-align: center;
            color: #34495e;
        }
    </style>
</head>

<body>
    <!-- Toggle button for opening/closing the sidebar -->
    <button id="toggle-btn" class="toggle-btn"><span>☰</span></button>

    <!-- Sidebar Navigation -->
    <div id="sidebar" class="sidebar">
        <ul class="nav-list">
            <li class="nav-item"><a href="/eligible-tests">View Available Tests</a></li>
            <li class="nav-item"><a href="/student/results">View Results</a></li>
            <li class="nav-item"><a href="/student/profile">Profile</a></li>
            <li class="nav-item"><a href="/student/settings">Settings</a></li>
            <li class="nav-item"><a href="/logout">Logout</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="settings-container">
            <h2>Account Settings</h2>
            <p class="message">No settings available at this time.</p>
        </div>
    </div>

    <script>
        // JavaScript to toggle sidebar and change icon smoothly
        const toggleBtn = document.getElementById('toggle-btn');
        const toggleIcon = toggleBtn.querySelector('span');
        const sidebar = document.getElementById('sidebar');

        toggleBtn.addEventListener('click', function () {
            sidebar.classList.toggle('active');
            toggleBtn.classList.toggle('active');
            toggleIcon.textContent = sidebar.classList.contains('active') ? '✕' : '☰';
        });
    </script>
</body>

</html>