<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create a New Test - Test Nexus</title>
    <link rel="stylesheet" href="/css/createTestCommon.css" />
    <link rel="stylesheet" href="/css/createTestTeacher.css" />
</head>

<body>
    <div class="form-container">
        <h1>Create a New Test</h1>
        <form action="/teacher/tests" method="POST">
            <label for="testName">Test Name</label>
            <input type="text" id="testName" name="testName" required placeholder="Enter test name" />
            <!-- Hidden assignedTeacher field set to current teacher -->
            <input type="hidden" name="assignedTeacher" value="<%= user._id %>">
            <label>Eligible Students</label>
            <div class="student-list">
                <% students.forEach(student=> { %>
                    <div class="student-item">
                        <input type="checkbox" name="eligibleStudents" value="<%= student._id %>" />
                        <%= student.username %>
                    </div>
                    <% }) %>
            </div>
            <button type="submit">Create Test</button>
        </form>
        <a href="/teacher" class="back-link">Back to Dashboard</a>
    </div>
</body>

</html>