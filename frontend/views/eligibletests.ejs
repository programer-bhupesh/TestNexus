<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TestNexus - A central hub for managing tests and evaluations</title>
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            /* Midnight blue gradient */
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 40px;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            background: rgba(34, 34, 66, 0.9);
            /* Glassmorphism */
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease-in-out;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #3498db, #2980b9);
            /* Student blue gradient */
            opacity: 0.2;
            z-index: 0;
            pointer-events: none;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 40px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 1;
        }

        .test-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            position: relative;
            z-index: 1;
        }

        .test-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .test-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 20px rgba(52, 152, 219, 0.4);
            /* Blue glow */
            background: rgba(255, 255, 255, 0.15);
        }

        .test-name {
            font-size: 1.4em;
            font-weight: 500;
            color: #d0d0e0;
            margin: 0 0 15px 0;
            word-break: break-word;
        }

        .take-test-btn {
            display: inline-block;
            padding: 12px 20px;
            background: linear-gradient(to right, #3498db, #2980b9);
            /* Student blue */
            color: #ffffff;
            text-decoration: none;
            border-radius: 25px;
            font-size: 1em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
            transition: all 0.3s ease;
            align-self: flex-end;
        }

        .take-test-btn:hover {
            background: linear-gradient(to right, #2980b9, #3498db);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.6);
            /* Blue glow */
        }

        /* Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Adjustments */
        @media (max-width: 768px) {
            .container {
                padding: 20px;
                max-width: 90%;
            }

            h1 {
                font-size: 1.8em;
            }

            .test-list {
                grid-template-columns: 1fr;
            }

            .test-card {
                padding: 15px;
            }

            .take-test-btn {
                width: 100%;
                padding: 14px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Eligible Tests</h1>
        <ul class="test-list">
            <% tests.forEach(test=> { %>
                <li class="test-card">
                    <h2 class="test-name">
                        <%= test.testName %>
                    </h2>
                    <a href="/tests/<%= test._id %>" class="take-test-btn">Take Test</a>
                </li>
                <% }) %>
        </ul>
    </div>
</body>

</html>