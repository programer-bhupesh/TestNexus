<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test: <%= test.testName %> - Test Nexus</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.33.0/min/vs/loader.min.js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 40px;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 1000px;
            background: rgba(34, 34, 66, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease-in-out;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #3498db, #2980b9);
            opacity: 0.2;
            z-index: 0;
            pointer-events: none;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 1;
        }

        .timer-container {
            text-align: center;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        #timer {
            font-size: 1.5em;
            font-weight: 500;
            color: #3498db;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 20px;
            border-radius: 8px;
            display: inline-block;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
        }

        .popup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(34, 34, 66, 0.95);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
            z-index: 1000;
            text-align: center;
            color: #ffffff;
            animation: fadeIn 0.3s ease-in-out;
        }

        .popup h2 {
            margin-bottom: 20px;
            font-size: 1.8em;
            color: #3498db;
        }

        .popup p {
            font-size: 1.2em;
            margin-bottom: 20px;
        }

        .popup button {
            padding: 10px 30px;
            background: linear-gradient(to right, #3498db, #2980b9);
            border: none;
            border-radius: 25px;
            color: #ffffff;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .popup button:hover {
            background: linear-gradient(to right, #2980b9, #3498db);
            transform: scale(1.05);
        }

        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 999;
        }

        .question {
            margin-bottom: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            position: relative;
            z-index: 1;
            transition: box-shadow 0.3s ease;
        }

        .question:hover {
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.3);
        }

        h3 {
            color: #d0d0e0;
            font-size: 1.5em;
            margin-bottom: 15px;
            font-weight: 500;
        }

        label {
            display: block;
            color: #d0d0e0;
            font-weight: 500;
            font-size: 1.1em;
            margin-bottom: 8px;
        }

        select {
            width: 100%;
            max-width: 200px;
            padding: 12px;
            border: none;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-size: 1em;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
            margin-bottom: 15px;
        }

        select:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 0 0 10px rgba(52, 152, 219, 0.6);
        }

        .mc-options label {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            font-size: 1em;
            color: #d0d0e0;
            transition: color 0.3s ease;
        }

        .mc-options input[type="radio"] {
            margin-right: 10px;
            accent-color: #3498db;
            width: 18px;
            height: 18px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .mc-options input[type="radio"]:hover {
            transform: scale(1.2);
        }

        .code-editor-container {
            width: 100%;
            height: 350px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: #1e1e1e;
            margin-bottom: 15px;
            position: relative;
        }

        .test-cases {
            margin-top: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            font-size: 1em;
            color: #d0d0e0;
        }

        .test-cases pre {
            margin: 5px 0;
            white-space: pre-wrap;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.95em;
            color: #ffffff;
        }

        .output-container {
            margin-top: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.95em;
            color: #d0d0e0;
            min-height: 50px;
            transition: background 0.3s ease;
        }

        .accepted {
            color: #2ecc71;
            font-weight: bold;
        }

        .wrong {
            color: #e74c3c;
            font-weight: bold;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 25px;
            font-size: 1em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #ffffff;
            background: linear-gradient(to right, #3498db, #2980b9);
            cursor: pointer;
            transition: all 0.3s ease;
            margin-right: 10px;
            margin-top: 15px;
        }

        button:hover {
            background: linear-gradient(to right, #2980b9, #3498db);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(52, 152, 219, 0.6);
        }

        .submit-btn {
            display: block;
            width: 200px;
            margin: 30px auto 0;
            padding: 14px;
            font-size: 1.2em;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
                max-width: 90%;
            }

            h1 {
                font-size: 1.8em;
            }

            .timer-container {
                margin-bottom: 15px;
            }

            #timer {
                font-size: 1.2em;
                padding: 8px 15px;
            }

            .question {
                padding: 15px;
            }

            button {
                width: 100%;
                margin-right: 0;
                margin-bottom: 10px;
            }

            .submit-btn {
                width: 100%;
            }

            .code-editor-container {
                height: 250px;
            }

            .popup {
                width: 90%;
                padding: 20px;
            }

            .popup h2 {
                font-size: 1.5em;
            }

            .popup p {
                font-size: 1em;
            }
        }
    </style>
</head>

<body>
    <div class="overlay" id="overlay"></div>
    <div class="popup" id="popup">
        <h2>Time's Up!</h2>
        <p>Your test has been automatically submitted.</p>
        <button onclick="window.location.href='/student/results'">View Results</button>
    </div>
    <div class="container">
        <h1>Test: <%= test.testName %>
        </h1>
        <div class="timer-container">
            <div id="timer">Time Left: 00:00:00</div>
        </div>
        <form action="/tests/<%= test._id %>/submit" method="POST" id="testForm">
            <% test.questions.forEach((question, index)=> { %>
                <div class="question">
                    <h3>
                        <%= index + 1 %>. <%= question.questionText %>
                    </h3>
                    <% if (question.type==="multiple-choice" ) { %>
                        <div class="mc-options">
                            <% question.options.forEach((option, i)=> { %>
                                <label>
                                    <input type="radio" name="answers[<%= question._id %>]" value="<%= i %>" required>
                                    <%= option %>
                                </label>
                                <% }) %>
                        </div>
                        <% } else if (question.type==="coding" ) { %>
                            <label for="language-<%= question._id %>">Select Language:</label>
                            <select name="languages[<%= question._id %>]" id="language-<%= question._id %>" required>
                                <option value="c">C</option>
                                <option value="cpp">C++</option>
                                <option value="java">Java</option>
                                <option value="python3" selected>Python</option>
                                <option value="javascript">JavaScript</option>
                                <option value="ruby">Ruby</option>
                                <option value="swift">Swift</option>
                            </select>
                            <div class="code-editor-container" id="editor-<%= question._id %>"></div>
                            <textarea name="answers[<%= question._id %>]" id="code-<%= question._id %>"
                                class="code-editor" style="display: none;"></textarea>
                            <div class="test-cases">
                                <label>Test Cases:</label>
                                <pre>Inputs:
<%= question.testCases.length %>
<% question.testCases.forEach(tc => { %><%= tc.input %>
<% }) %></pre>
                                <pre>Expected Outputs:
<% question.testCases.forEach(tc => { %><%= tc.expectedOutput %>
<% }) %></pre>
                            </div>
                            <button type="button" class="run-code" data-question-id="<%= question._id %>">Run
                                Code</button>
                            <button type="button" class="run-tests" data-question-id="<%= question._id %>">Run Test
                                Cases</button>
                            <div class="output-container" id="output-<%= question._id %>">Output will appear here...
                            </div>
                            <% } %>
                </div>
                <% }) %>
                    <button type="submit" class="submit-btn">Submit Test</button>
        </form>
    </div>

    <script type="application/json" id="test-data">
        <%- JSON.stringify(test) %>
    </script>
    <script src="/js/takeTest.js"></script>
</body>

</html>