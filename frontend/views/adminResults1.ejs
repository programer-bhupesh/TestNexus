<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Test Results - Test Nexus</title>
  <style>
    body {
      background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
      min-height: 100vh;
      font-family: 'Arial', sans-serif;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #2c3e50;
      font-size: 2.5em;
      margin: 40px 0 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 600;
    }

    a.back-link {
      display: block;
      text-align: center;
      color: #3498db;
      font-size: 1.2em;
      margin: 20px 0;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    a.back-link:hover {
      color: #2980b9;
    }

    .results-container {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 25px;
    }

    .result-card {
      background: #ffffff;
      border-radius: 15px;
      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
      padding: 20px;
      position: relative;
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .result-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
    }

    .result-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(to right, #9b59b6, #8e44ad);
    }

    .result-header {
      border-bottom: 2px solid #eee;
      padding-bottom: 15px;
      margin-bottom: 15px;
    }

    .result-header h2 {
      margin: 0;
      font-size: 1.4em;
      color: #2c3e50;
      font-weight: 600;
    }

    .result-header p {
      margin: 5px 0 0;
      color: #34495e;
      font-size: 1.1em;
    }

    .answer-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .answer-item {
      background: #f8f9fa;
      padding: 10px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.3s ease;
    }

    .answer-item:hover {
      background: #eef1f5;
    }

    .answer-item span {
      color: #34495e;
      font-size: 1em;
    }

    .total-score {
      margin-top: 15px;
      padding-top: 15px;
      border-top: 2px solid #eee;
      text-align: right;
      font-size: 1.2em;
      color: #2c3e50;
      font-weight: 500;
    }

    .no-results {
      text-align: center;
      color: #7f8c8d;
      font-size: 1.5em;
      margin: 50px 0;
      font-style: italic;
    }
  </style>
</head>

<body>
  <h1>All Test Results</h1>
  <a href="/admin" class="back-link">Back to Dashboard</a>
  <% if (responses.length===0) { %>
    <p class="no-results">No results available yet.</p>
    <% } else { %>
      <div class="results-container">
        <% responses.forEach(function(response) { %>
          <div class="result-card">
            <div class="result-header">
              <h2>
                <%= response.studentId ? response.studentId.username : 'Unknown Student' %>
              </h2>
              <p>Test: <%= response.testId ? response.testId.testName : 'Test Not Found' %>
              </p>
            </div>
            <% if (response.studentId && response.testId) { %>
              <div class="answer-list">
                <% response.answers.forEach(function(answer, index) { %>
                  <div class="answer-item">
                    <span>Question <%= index + 1 %></span>
                    <span>Score: <%= answer.score !==undefined ? answer.score : 'N/A' %></span>
                  </div>
                  <% }); %>
              </div>
              <div class="total-score">
                Total Score: <%= response.totalScore !==undefined ? response.totalScore : 'N/A' %>
              </div>
              <% } else { %>
                <div class="answer-list">
                  <div class="answer-item">
                    <span>No answers available</span>
                    <span>N/A</span>
                  </div>
                </div>
                <div class="total-score">
                  Total Score: <%= response.totalScore !==undefined ? response.totalScore : 'N/A' %>
                </div>
                <% } %>
          </div>
          <% }); %>
      </div>
      <% } %>
</body>

</html>