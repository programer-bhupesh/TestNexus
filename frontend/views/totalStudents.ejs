<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Total Students - Test Nexus</title>
  <style>
    /* ===== Base Styling ===== */
body {
  background: linear-gradient(135deg, #0f0f1a, #1a1a2e);
  min-height: 100vh;
  font-family: 'Poppins', Arial, sans-serif;
  padding: 20px;
  position: relative;
  color: #e0e0e0;
  transition: 0.4s ease;
}

/* ===== Heading ===== */
h1 {
  text-align: center;
  color: #ffffff;
  font-size: 2.8em;
  margin: 50px 0 30px;
  text-transform: uppercase;
  letter-spacing: 3px;
  font-weight: 700;
  text-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
}

/* ===== Back Button ===== */
.back-btn {
  position: absolute;
  top: 20px;
  left: 20px;
  background: linear-gradient(135deg, #f7d46d, #ff9900);
  color: #0f0f1a;
  border: none;
  padding: 12px 26px;
  border-radius: 30px;
  font-size: 1.1em;
  font-weight: 600;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: 0.3s ease;
  box-shadow: 0 4px 15px rgba(255, 188, 0, 0.4);
}

.back-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(255, 188, 0, 0.6);
}


/* ============================================================
   STUDENT CARD GRID
   ============================================================ */
.students-container {
  max-width: 1300px;
  margin: 40px auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 32px;
}

/* ============================================================
   STUDENT CARD WITH DARK GLASS HOVER EFFECT
   ============================================================ */
.student-card {
  background: rgba(35, 35, 60, 0.45);
  backdrop-filter: blur(10px);
  border-radius: 18px;
  padding: 25px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: 0.35s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
}

/* === DARK GLASS HOVER EFFECT === */
.student-card:hover {
  transform: translateY(-12px);
  background: rgba(20, 20, 35, 0.70);
  box-shadow: 
     0 20px 40px rgba(0, 0, 0, 0.7),
     0 0 20px rgba(52, 152, 219, 0.45);
}

/* Top Accent Line */
.student-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 5px;
  width: 100%;
  background: linear-gradient(to right, #4aa3ff, #005fbb);
}

/* Student Name */
.student-card h3 {
  margin: 0 0 15px;
  font-size: 1.6em;
  color: #ffffff;
  font-weight: 700;
  text-shadow: 0 2px 5px rgba(0,0,0,0.5);
}

/* Detail Hover Highlight */
.student-card p {
  color: #d6d6e8;
  margin: 10px 0;
  font-size: 1.06em;
  padding: 5px 0;
  transition: 0.25s;
}

.student-card p:hover {
  color: #4aa3ff;
  transform: translateX(4px);
}

.student-card p strong {
  color: #ffffff;
}

/* ============================================================
   BUTTON GROUP
   ============================================================ */
.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 22px;
}

.update-btn,
.delete-btn {
  flex: 1;
  padding: 12px;
  margin: 0 6px;
  border-radius: 25px;
  border: none;
  cursor: pointer;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: 0.3s ease;
  color: white;
}

/* Update Button */
.update-btn {
  background: linear-gradient(135deg, #a26bf8, #7129d1);
  box-shadow: 0 4px 15px rgba(162, 107, 248, 0.3);
}

.update-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(162, 107, 248, 0.6);
}

/* Delete Button */
.delete-btn {
  background: linear-gradient(135deg, #ff5b5b, #d62828);
  box-shadow: 0 4px 15px rgba(255, 90, 90, 0.4);
}

.delete-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(255, 90, 90, 0.7);
}

/* ===== No Students ===== */
.no-students {
  text-align: center;
  color: #9a9ac7;
  font-size: 1.6em;
  margin: 60px 0;
  font-style: italic;
  text-shadow: 0 2px 5px rgba(0,0,0,0.4);
}


  </style>
</head>

<body>
  <button type="button" class="back-btn" onclick="window.location.href='/admin'">Back to Dashboard</button>
  <h1>All Students</h1>
  <% if (students.length===0) { %>
    <p class="no-students">No students found.</p>
    <% } else { %>
      <div class="students-container">
        <% students.forEach(student=> { %>
          <div class="student-card">
            <h3>
              <%= student.username %>
            </h3>
            <p><strong>Email:</strong>
              <%= student.email || 'N/A' %>
            </p>
            <p><strong>Full Name:</strong>
              <%= student.fullName || 'N/A' %>
            </p>
            <div class="button-group">
              <button type="button" class="update-btn"
                onclick="window.location.href='/students/<%= student._id %>/update'">Update</button>
              <form action="/students/<%= student._id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="delete-btn"
                  onclick="return confirm('Are you sure you want to delete this student? This will also delete all their responses.')">Delete</button>
              </form>
            </div>
          </div>
          <% }) %>
      </div>
      <% } %>
        <% if (typeof message !=='undefined' ) { %>
          <p
            style="text-align: center; color: #9b59b6; font-size: 1.2em; margin: 20px 0; text-shadow: 0 0 5px rgba(155, 89, 182, 0.5);">
            <%= message %>
          </p>
          <% } %>
</body>

</html>