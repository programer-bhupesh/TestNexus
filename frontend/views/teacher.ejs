<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Test Nexus - Teacher Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body class="teacher-theme">
    <!-- Toggle button for opening/closing the sidebar -->
    <button id="toggle-btn" class="toggle-btn"><span>☰</span></button>

    <!-- Sidebar Navigation -->
    <div id="sidebar" class="sidebar">
        <ul class="nav-list">
            <li class="nav-item"><a href="/my-tests">View Assigned Tests</a></li>
            <li class="nav-item"><a href="/teacher/tests/create">Create Test</a></li>
            <li class="nav-item"><a href="/teacher/results">View Student Results</a></li>
            <li class="nav-item"><a href="/teacher/profile">Profile</a></li>
            <li class="nav-item"><a href="/logout">Logout</a></li>
        </ul>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <h1>Welcome to Test Nexus</h1>
        <h2>Welcome <%= username %>
        </h2>
    </div>

    <script src="/js/dashboard.js"></script>
</body>

</html>