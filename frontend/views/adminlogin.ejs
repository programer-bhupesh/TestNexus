<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TestNexus - A central hub for managing tests and evaluations.</title>
  <link rel="stylesheet" href="./css/loginstyles.css" />
</head>

<body>
  <div class="root">
    <form action="/adminlogin" method="post">
      <label for="username">UserName:</label>
      <input name="username" id="username" required="true" />
      <label for="password">Password:</label>
      <input type="password" name="password" id="password" required="true" />
      <a href="forgetpwd">forget Password</a>
      <br /><br />
      <button type="submit">Login</button>
      <br /><br />
      <div class="acc">
        <pre>Don't Have an account ? <a href="/signup">Sign up</a></pre>
      </div>
    </form>
  </div>
  <script src="./js/pwdscript.js"></script>
</body>

</html>