<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Profile - Test Nexus</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
            color: #e0e0e0;
        }

        /* Toggle Button Styles */
        .toggle-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            border: none;
            border-radius: 12px;
            width: 50px;
            height: 50px;
            font-size: 24px;
            color: #ffffff;
            cursor: pointer;
            z-index: 1100;
            transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .teacher-theme .toggle-btn {
            background: linear-gradient(45deg, #2ecc71, #27ae60);
            box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
        }

        .teacher-theme .toggle-btn:hover {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(46, 204, 113, 0.6);
        }

        .teacher-theme .toggle-btn.active {
            background: linear-gradient(45deg, #9b59b6, #8e44ad);
        }

        .teacher-theme .toggle-btn.active:hover {
            background: linear-gradient(45deg, #8e44ad, #9b59b6);
            box-shadow: 0 0 15px rgba(155, 89, 182, 0.6);
        }

        .toggle-btn span {
            display: inline-block;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .toggle-btn.active span {
            transform: rotate(180deg);
            opacity: 0.9;
        }

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 270px;
            height: 100vh;
            background: #252545;
            transform: translateX(-100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
            padding: 90px 0 20px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #ff8e53 #252545;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar .nav-list {
            list-style: none;
            padding: 0 15px;
        }

        .sidebar .nav-item {
            margin-bottom: 10px;
        }

        .sidebar .nav-item a {
            display: flex;
            align-items: center;
            padding: 15px 25px;
            color: #d8d8e8;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 400;
            transition: all 0.3s ease;
            border-radius: 10px;
        }

        .sidebar .nav-item a:hover {
            color: #ffffff;
            background: rgba(255, 142, 83, 0.1);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        .sidebar .nav-item a[href="/logout"] {
            color: #ff3366;
        }

        .sidebar .nav-item a[href="/logout"]:hover {
            color: #ff6680;
            background: rgba(255, 51, 102, 0.1);
        }

        /* Main Content Area */
        .main-content {
            padding: 100px 20px 20px 80px;
            transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .sidebar.active~.main-content {
            padding-left: 350px;
        }

        .form-container {
            background: rgba(34, 34, 66, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 550px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease-in-out;
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #2ecc71, #27ae60);
            opacity: 0.2;
            z-index: 0;
            pointer-events: none;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 30px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 1;
        }

        form {
            position: relative;
            z-index: 1;
        }

        form label {
            display: block;
            color: #d0d0e0;
            font-size: 1.1em;
            margin: 20px 0 8px;
            font-weight: 400;
        }

        form input[type="text"],
        form input[type="email"],
        form input[type="password"] {
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 20px;
            border: none;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            font-size: 1em;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 0 10px rgba(46, 204, 113, 0.6);
        }

        form button[type="submit"] {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 25px;
            font-size: 1.2em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.3s ease;
            background: linear-gradient(to right, #2ecc71, #27ae60);
        }

        button[type="submit"]:hover {
            background: linear-gradient(to right, #27ae60, #2ecc71);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(46, 204, 113, 0.6);
        }

        a {
            display: block;
            text-align: center;
            color: #d0d0e0;
            font-size: 1.2em;
            margin-top: 20px;
            text-decoration: none;
            transition: color 0.3s ease, transform 0.3s ease;
            position: relative;
            z-index: 1;
        }

        a:hover {
            color: #ffffff;
            transform: translateY(-2px);
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            .form-container {
                padding: 20px;
                max-width: 90%;
            }

            h1 {
                font-size: 1.8em;
            }

            form input[type="text"],
            form input[type="email"],
            form input[type="password"] {
                padding: 10px;
                font-size: 1em;
            }

            form button[type="submit"] {
                padding: 12px;
                font-size: 1.1em;
            }

            a {
                font-size: 1em;
            }

            .sidebar {
                width: 220px;
            }

            .sidebar.active~.main-content {
                padding-left: 280px;
            }

            .toggle-btn {
                width: 42px;
                height: 42px;
                font-size: 20px;
            }
        }
    </style>
</head>

<body class="teacher-theme">
    <button id="toggle-btn" class="toggle-btn"><span>☰</span></button>
    <div id="sidebar" class="sidebar">
        <div class="nav-list">
            <div class="nav-item"><a href="/teacher">Dashboard</a></div>
            <div class="nav-item"><a href="/my-tests">My Tests</a></div>
            <div class="nav-item"><a href="/teacher/results">Results</a></div>
            <div class="nav-item"><a href="/teacher/profile">Profile</a></div>
            <div class="nav-item"><a href="/logout">Logout</a></div>
        </div>
    </div>
    <div class="main-content">
        <div class="form-container">
            <h1>Your Profile</h1>
            <form action="/teacher/profile" method="POST">
                <label for="username">Username (Read-only):</label>
                <input type="text" id="username" name="username" value="<%= username %>" disabled>

                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="<%= email || '' %>"
                    placeholder="Leave blank to keep current">

                <label for="fullName">Full Name:</label>
                <input type="text" id="fullName" name="fullName" value="<%= fullName || '' %>"
                    placeholder="Leave blank to keep current">

                <label for="currentPassword">Current Password:</label>
                <input type="password" id="currentPassword" name="currentPassword"
                    placeholder="Required to change password">

                <label for="newPassword">New Password:</label>
                <input type="password" id="newPassword" name="newPassword" placeholder="Required to change password">

                <button type="submit">Update Profile</button>
            </form>
            <a href="/teacher">Back to Dashboard</a>
        </div>
    </div>
    <script>
        const toggleBtn = document.getElementById('toggle-btn');
        const toggleIcon = toggleBtn.querySelector('span');
        const sidebar = document.getElementById('sidebar');

        toggleBtn.addEventListener('click', function () {
            sidebar.classList.toggle('active');
            toggleBtn.classList.toggle('active');
            toggleIcon.textContent = sidebar.classList.contains('active') ? '✕' : '☰';
        });
    </script>
</body>

</html>