<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Teacher - Test Nexus</title>
    <style>
        .form-container {
            max-width: 500px;
            margin: 50px auto;
            padding: 30px;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 20px;
            font-size: 2em;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        label {
            display: block;
            margin: 15px 0 5px;
            color: #34495e;
            font-weight: 500;
            font-size: 1.1em;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
            color: #34495e;
            box-sizing: border-box;
        }

        input[type="submit"] {
            background: linear-gradient(to right, #2ecc71, #27ae60);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1.1em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: background 0.3s ease, transform 0.3s ease;
            display: block;
            margin: 20px auto 0;
        }

        input[type="submit"]:hover {
            background: linear-gradient(to right, #27ae60, #219653);
            transform: scale(1.05);
        }

        a {
            display: block;
            text-align: center;
            color: #3498db;
            font-size: 1.1em;
            margin-top: 20px;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        a:hover {
            color: #2980b9;
        }
    </style>
</head>

<body>
    <div class="form-container">
        <h1>Update Teacher: <%= teacher.username %>
        </h1>
        <form action="/teachers/<%= teacher._id %>/update" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= teacher.email || '' %>"
                placeholder="Leave blank to keep current">

            <label for="fullName">Full Name:</label>
            <input type="text" id="fullName" name="fullName" value="<%= teacher.fullName || '' %>"
                placeholder="Leave blank to keep current">

            <label for="password">New Password (optional):</label>
            <input type="password" id="password" name="password" placeholder="Leave blank to keep current">

            <input type="submit" value="Update Teacher">
        </form>
        <a href="/total-teachers">Back to Teachers</a>
    </div>
</body>

</html>