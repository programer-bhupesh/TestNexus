<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Teacher - Test Nexus</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            color: #e0e0e0;
        }

        /* Form Container */
        .form-container {
            background: rgba(34, 34, 66, 0.9);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.5s ease-in-out;
        }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, #2ecc71, #27ae60);
            opacity: 0.2;
            z-index: 0;
            pointer-events: none;
        }

        /* Heading */
        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 30px;
            text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 1;
        }

        /* Form Styles */
        form {
            position: relative;
            z-index: 1;
        }

        label {
            display: block;
            color: #d0d0e0;
            font-size: 1.1em;
            margin-bottom: 8px;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 20px;
            border: none;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            font-size: 1em;
            transition: all 0.3s ease;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        input[type="email"]:focus,
        input[type="text"]:focus,
        input[type="password"]:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.15);
            box-shadow: 0 0 10px rgba(46, 204, 113, 0.6);
        }

        /* Submit Button */
        input[type="submit"] {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 25px;
            font-size: 1.2em;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #ffffff;
            background: linear-gradient(to right, #2ecc71, #27ae60);
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
        }

        input[type="submit"]:hover {
            background: linear-gradient(to right, #27ae60, #2ecc71);
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(46, 204, 113, 0.6);
        }

        /* Back Link */
        a {
            color: #d0d0e0;
            font-size: 1em;
            text-align: center;
            margin: 20px 0 0;
            text-decoration: none;
            transition: color 0.3s ease;
            display: block;
            position: relative;
            z-index: 1;
        }

        a:hover {
            color: #ffffff;
            text-shadow: 0 0 5px rgba(255, 255, 255, 0.5);
        }

        /* Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive Adjustments */
        @media (max-width: 480px) {
            .form-container {
                padding: 30px;
                max-width: 90%;
            }

            h1 {
                font-size: 1.8em;
            }

            input[type="email"],
            input[type="text"],
            input[type="password"] {
                padding: 10px;
                font-size: 0.95em;
            }

            input[type="submit"] {
                padding: 12px;
                font-size: 1.1em;
            }

            a {
                font-size: 0.95em;
            }
        }
    </style>
</head>

<body>
    <div class="form-container">
        <h1>Update Teacher: <%= teacher.username %>
        </h1>
        <form action="/teachers/<%= teacher._id %>/update" method="POST">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= teacher.email || '' %>"
                placeholder="Leave blank to keep current">

            <label for="fullName">Full Name:</label>
            <input type="text" id="fullName" name="fullName" value="<%= teacher.fullName || '' %>"
                placeholder="Leave blank to keep current">

            <label for="password">New Password (optional):</label>
            <input type="password" id="password" name="password" placeholder="Leave blank to keep current">

            <input type="submit" value="Update Teacher">
        </form>
        <a href="/total-teachers">Back to Teachers</a>
    </div>
</body>

</html>