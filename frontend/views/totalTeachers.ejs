<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Total Teachers - Test Nexus</title>
  <style>
    body {
      background: linear-gradient(135deg, #1a1a2e, #16213e);
      /* Deep midnight blue gradient */
      min-height: 100vh;
      font-family: 'Arial', sans-serif;
      padding: 20px;
      position: relative;
    }

    h1 {
      text-align: center;
      color: #e0e0e0;
      font-size: 2.5em;
      margin: 40px 0 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 600;
      text-shadow: 0 циона 2.5em;
      margin: 40px 0 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 600;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .back-btn {
      position: absolute;
      top: 20px;
      left: 20px;
      color: white;
      background: linear-gradient(to right, #ffd700, #ffaa00);
      /* Gold to amber */
      border: none;
      padding: 12px 25px;
      border-radius: 25px;
      cursor: pointer;
      font-size: 1.2em;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
      text-align: center;
    }

    .back-btn:hover {
      background: linear-gradient(to right, #ffaa00, #ff8c00);
      transform: scale(1.05);
      box-shadow: 0 0 12px rgba(255, 215, 0, 0.6);
    }

    .teachers-container {
      max-width: 1200px;
      margin: 40px auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 25px;
    }

    .teacher-card {
      background: linear-gradient(145deg, #2a2a4a, #1f1f38);
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
      padding: 25px;
      position: relative;
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .teacher-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), 0 0 15px rgba(46, 204, 113, 0.3);
      /* Green glow */
    }

    .teacher-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(to right, #2ecc71, #27ae60);
      /* Green to deep green */
    }

    .teacher-card h3 {
      margin: 0 0 15px;
      font-size: 1.5em;
      color: #ffffff;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    }

    .teacher-card p {
      margin: 10px 0;
      color: #b0b0c0;
      font-size: 1.1em;
      line-height: 1.4;
    }

    .teacher-card p strong {
      color: #e0e0e0;
      font-weight: 500;
    }

    .button-group {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .update-btn,
    .delete-btn {
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 25px;
      cursor: pointer;
      font-size: 1em;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
      flex: 1;
      margin: 0 5px;
      background: none;
    }

    .update-btn {
      background: linear-gradient(to right, #f1c40f, #e67e22);
      /* Yellow to orange */
    }

    .update-btn:hover {
      background: linear-gradient(to right, #e67e22, #d35400);
      transform: scale(1.05);
      box-shadow: 0 0 12px rgba(241, 196, 15, 0.6);
    }

    .delete-btn {
      background: linear-gradient(to right, #e91e63, #c2185b);
      /* Pink to deep pink */
    }

    .delete-btn:hover {
      background: linear-gradient(to right, #c2185b, #ad1457);
      transform: scale(1.05);
      box-shadow: 0 0 12px rgba(233, 30, 99, 0.6);
    }

    .no-teachers {
      text-align: center;
      color: #8080a0;
      font-size: 1.5em;
      margin: 50px 0;
      font-style: italic;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
  </style>
</head>

<body>
  <button type="button" class="back-btn" onclick="window.location.href='/admin'">Back to Dashboard</button>
  <h1>All Teachers</h1>
  <% if (teachers.length===0) { %>
    <p class="no-teachers">No teachers found.</p>
    <% } else { %>
      <div class="teachers-container">
        <% teachers.forEach(teacher=> { %>
          <div class="teacher-card">
            <h3>
              <%= teacher.username %>
            </h3>
            <p><strong>Email:</strong>
              <%= teacher.email || 'N/A' %>
            </p>
            <p><strong>Full Name:</strong>
              <%= teacher.fullName || 'N/A' %>
            </p>
            <div class="button-group">
              <button type="button" class="update-btn"
                onclick="window.location.href='/teachers/<%= teacher._id %>/update'">Update</button>
              <form action="/teachers/<%= teacher._id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="delete-btn"
                  onclick="return confirm('Are you sure you want to delete this teacher? This will also delete all their tests, questions, and responses.')">Delete</button>
              </form>
            </div>
          </div>
          <% }) %>
      </div>
      <% } %>
        <% if (typeof message !=='undefined' ) { %>
          <p
            style="text-align: center; color: #f1c40f; font-size: 1.2em; margin: 20px 0; text-shadow: 0 0 5px rgba(241, 196, 15, 0.5);">
            <%= message %>
          </p>
          <% } %>
</body>

</html>