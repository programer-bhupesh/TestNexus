    <script>
        const chatForm = document.getElementById("chatForm");
        const messageInput = document.getElementById("messageInput");
        const chatHistory = document.getElementById("chatHistory");

        chatForm.onsubmit = async (e) => {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (!message) return;

            messageInput.value = "";

            // Create a temporary chat box with loading...
            const chatBox = document.createElement("div");
            chatBox.className = "chat-box";

            const deleteBtn = document.createElement("button");
            deleteBtn.className = "delete-btn";
            deleteBtn.innerHTML = "🗑️";
            chatBox.appendChild(deleteBtn); // Button logic updated later

            const userMsg = document.createElement("div");
            userMsg.className = "user";
            userMsg.textContent = message;
            chatBox.appendChild(userMsg);

            const typingDiv = document.createElement("div");
            typingDiv.className = "ai";
            typingDiv.textContent = "Typing...";
            chatBox.appendChild(typingDiv);

            chatHistory.prepend(chatBox);

            // Send message to server
            const res = await fetch("/<%= user.role %>/ai-assist", {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message })
            });

            const chat = await res.json(); // Full chat with _id and messages

            // Clear temporary typing
            chatBox.innerHTML = "";

            // Add delete button with chat ID
            const btn = document.createElement("button");
            btn.className = "delete-btn";
            btn.innerHTML = "🗑️";
            btn.onclick = () => deleteChat(chat._id);
            chatBox.appendChild(btn);

            // Append messages
            chat.messages.forEach(msg => {
                const msgDiv = document.createElement("div");
                msgDiv.className = msg.from;
                msgDiv.textContent = msg.text;
                chatBox.appendChild(msgDiv);
            });

            chatBox.id = `chat-${chat._id}`;
        };

        function deleteChat(chatId) {
            fetch(`/<%= user.role %>/ai-assist/${chatId}`, {
                method: "DELETE"
            }).then(() => {
                const chatBox = document.getElementById(`chat-${chatId}`);
                if (chatBox) chatBox.remove();
            });
        }
    </script>    
    
</body>

</html>