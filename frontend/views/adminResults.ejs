<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Test Results - Test Nexus</title>
    <link rel="stylesheet" href="/css/adminResults.css" />
</head>

<body>
    <div class="container">
        <h1>All Test Results</h1>
        <a href="/admin" class="back-link"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
        <% if (responses.length===0) { %>
            <p class="no-results">No results available yet. Monitor system activity here.</p>
            <% } else { %>
                <div class="results-grid">
                    <% responses.forEach(response=> { %>
                        <% const percentage=response.answers.length> 0 ? ((response.totalScore /
                            response.answers.length) * 100).toFixed(2) : '0.00'; %>
                            <div class="result-card">
                                <div class="card-header">
                                    <h2>
                                        <%= response.studentId ? response.studentId.username : 'Unknown Student' %>
                                    </h2>
                                    <p class="test-name">Test: <%= response.testId ? response.testId.testName
                                            : 'Test Not Found' %>
                                    </p>
                                </div>
                                <div class="card-body">
                                    <p><strong>Score:</strong>
                                        <%= response.totalScore !==undefined ? response.totalScore : 'N/A' %> / <%=
                                                response.answers.length %>
                                    </p>
                                    <div class="percentage-circle">
                                        <span class="percentage-text">
                                            <%= percentage %>%
                                        </span>
                                    </div>
                                    <a href="/admin/results/<%= response._id %>" class="details-btn">View Details</a>
                                </div>
                            </div>
                            <% }) %>
                </div>
                <% } %>
    </div>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script>
        document.querySelectorAll('.result-card').forEach(card => {
            const percentage = parseFloat(card.querySelector('.percentage-text').textContent);
            card.querySelector('.percentage-circle').style.setProperty('--percentage-obtained', percentage);
        });
    </script>
</body>

</html>