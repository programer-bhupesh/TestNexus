<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bulk Upload Students - Test Nexus</title>
    <link rel="stylesheet" href="/css/bulkUpload.css">
</head>

<body>
    <div class="container student-theme">
        <h1>Bulk Upload Students</h1>
        <form action="/bulk-students" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="studentFile">Upload Student CSV File</label>
                <input type="file" id="studentFile" name="studentFile" accept=".xlsx" required>
            </div>
            <button type="submit">Upload Students</button>
        </form>
    </div>
</body>

</html>